NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/triskcraft
API_URL=http://localhost:3000

# Dedicated identity signing pair. Preserve PEM newlines or encode them as \n.
IDENTITY_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
IDENTITY_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
IDENTITY_KEY_ID=triskcraft-identity-1

# Independent secret for the browser session cookie (minimum 32 characters).
SESSION_SECRET=replace-with-an-independent-session-secret

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/oauth/discord
DISCORD_GUILD_ID=
DISCORD_REST_TOKEN=
SUPER_USER_DISCORD_ID=
# Base64-encoded 32-byte key used only to decrypt stored webhook secrets.
WEBHOOK_ENCRYPTION_KEY=

# Add these independently when their modules are implemented. Never reuse a
# secret between identity tokens, sessions, webhook HMAC and Discord.
# WEBHOOK_HMAC_SECRET=
