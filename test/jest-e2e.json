{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "setupFiles": ["<rootDir>/setup-env.ts"],
  "moduleNameMapper": {
    "^@triskcraft/db$": "<rootDir>/mocks/triskcraft-db.ts"
  },
  "transformIgnorePatterns": ["node_modules/(?!.*jose)"],
  "transform": {
    "^.+\\.(t|j)s$": "@swc/jest"
  }
}
